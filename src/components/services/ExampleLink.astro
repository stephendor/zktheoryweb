---
/**
 * ExampleLink.astro
 * List item for one example report on /services: its accessible HTML page
 * and, when it exists, the PDF printed from it.
 * Content comes from src/data/services-examples.ts.
 */
import DocLinks from '@components/services/DocLinks.astro';
import { servicesExamples } from '@data/services-examples';

interface Props {
  slug: string;
}

const example = servicesExamples.find((e) => e.slug === Astro.props.slug);
if (!example) throw new Error(`ExampleLink: no services example with slug "${Astro.props.slug}"`);
---

<li>
  <DocLinks
    page={`/services/examples/${example.slug}/`}
    pdf={`services/examples/${example.pdf}`}
    label={example.name}
  />
</li>
