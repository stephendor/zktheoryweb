---
/**
 * ExampleLink.astro
 * List item for an example PDF on /services.
 * Links to /services/examples/<file> only if that file exists in
 * public/services/examples/ at build time; otherwise renders the label with a
 * "coming soon" note, so the page never ships a broken link. Dropping the PDF
 * into that folder is all that is needed to turn the link on.
 */
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  file: string;
  label: string;
}

const { file, label } = Astro.props;
const path = join(process.cwd(), 'public', 'services', 'examples', file);
const available = existsSync(path);
const sizeKb = available ? Math.max(1, Math.round(statSync(path).size / 1024)) : 0;
---

<li>
  {available ? (
    <a href={`/services/examples/${file}`}>{label} (PDF, {sizeKb} KB)</a>
  ) : (
    <>
      {label}{' '}<span class="service-example__pending">— example PDF coming soon</span>
    </>
  )}
</li>
